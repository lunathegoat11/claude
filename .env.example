# ─────────────────────────────────────────────────────────────
# Kosha Health — environment configuration
# Copy to .env and adjust. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://kosha:kosha@localhost:5432/kosha?schema=public"

# Public base URL of the app (used for origin checks and absolute links)
APP_URL="http://localhost:3000"

# Long random secret (>= 32 chars). Used to pseudonymise IPs in audit logs.
# Generate with: openssl rand -base64 48
APP_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Allow new accounts to be created from the sign-up page
ALLOW_SIGNUP="true"

# Show a "Try the demo" button that signs into the shared, fictional demo
# account created by the seed script. Disable in production.
DEMO_LOGIN_ENABLED="true"

# ── File storage ───────────────────────────────────────────
# "local" stores files on disk (development / single server).
# "s3" stores files in any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, etc.).
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
MAX_UPLOAD_MB="15"

# Only needed when STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── AI assistant ───────────────────────────────────────────
# "demo"      – no external calls. Deterministic, grounded summaries built from your data.
# "anthropic" – Claude via the Anthropic API (requires ANTHROPIC_API_KEY)
# "openai"    – any OpenAI-compatible Chat Completions endpoint (requires OPENAI_API_KEY)
AI_PROVIDER="demo"
AI_MODEL=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Let the AI provider read text from images of lab reports (only used when a
# vision-capable provider is configured; otherwise images need manual entry).
AI_VISION_EXTRACTION="false"

# ── Email (password reset & email verification) ─────────────
# "console" prints emails (with their links) in the server terminal — fine for
# local use. "resend" sends real email via https://resend.com (free tier available).
EMAIL_PROVIDER="console"
EMAIL_FROM="Kosha <no-reply@example.com>"
RESEND_API_KEY=""

# ── Reading photos of lab reports ───────────────────────────
# Built-in OCR runs on your own server (no external service). Set "false" to disable.
OCR_ENABLED="true"

# ── Legal pages (Privacy Policy / Terms of Use) ─────────────
# Fill these in, have a lawyer review the policy text, then set LEGAL_REVIEWED="true"
# to remove the "draft" notice from the legal pages.
ORGANIZATION_NAME=""
CONTACT_EMAIL=""
GRIEVANCE_OFFICER_NAME=""
GRIEVANCE_OFFICER_EMAIL=""
LEGAL_REVIEWED="false"

# Log level: debug | info | warn | error
LOG_LEVEL="info"
